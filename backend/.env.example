# Oja Loom API: settings. Copy to .env for local use. Never commit the real file (.gitignore already blocks it).
# In production these are NOT stored in a file in the repository: see docs/DEPLOYMENT.md (Secret Manager + instance metadata).

# ---- required in production (the server refuses to start unless these are right) -------------------
OJALOOM_ENV=production
OJALOOM_FRONTEND_URL=https://app.example.com          # the web app on GitHub Pages (custom domain)
OJALOOM_PUBLIC_API_URL=https://api.example.com        # this server's own public address; sits on the SAME registrable domain
OJALOOM_ALLOWED_ORIGINS=https://app.example.com       # only these websites may call the API (comma separated, https only)
LITESTREAM_REPLICA_URL=gcs://your-project-ojaloom-db/ojaloom    # continuous database backup
# On DigitalOcean (or any S3-compatible bucket) use these instead, in /etc/ojaloom/ojaloom.env: see docs/DIGITALOCEAN.md and deploy/digitalocean/ojaloom.env.example
# LITESTREAM_REPLICA_URL=s3://your-bucket/ojaloom
# LITESTREAM_ENDPOINT=https://fra1.digitaloceanspaces.com
# LITESTREAM_REGION=fra1
# LITESTREAM_ACCESS_KEY_ID=...                          # SECRET
# LITESTREAM_SECRET_ACCESS_KEY=...                      # SECRET

# ---- identity shown on the Terms page -------------------------------------------------------------
OJALOOM_OPERATOR_NAME=Your Company Ltd
OJALOOM_SUPPORT_EMAIL=support@example.com
OJALOOM_SUPPORT_WHATSAPP=2347074235945                # customer-support chat, international format

# ---- Paystack (online payment for Oja Loom Pro) -------------------------------------------------------
# SECRET: put in Secret Manager as "ojaloom-paystack-secret", not here. sk_test_... while testing, sk_live_... when real.
# OJALOOM_PAYSTACK_SECRET=sk_live_xxx
# Paystack dashboard > Settings > API Keys & Webhooks > Webhook URL:  https://api.example.com/webhooks/paystack
OJALOOM_ENFORCE_PAYWALL=1                              # lock Pro features when a free trial ends (0 = everyone gets everything)

# ---- WhatsApp Business Cloud API (OPTIONAL: puts the PDF straight into the customer's WhatsApp) --------------
# Without these, "Send > WhatsApp" uses the phone's share sheet instead. See docs/WHATSAPP.md.
# OJALOOM_WA_PHONE_ID=123456789012345
# OJALOOM_WA_TOKEN=...                                  # SECRET: Secret Manager "ojaloom-wa-token"
# OJALOOM_WA_GRAPH_VERSION=v23.0
# OJALOOM_WA_TEMPLATE_RECEIPT=ojaloom_receipt
# OJALOOM_WA_TEMPLATE_STATEMENT=ojaloom_statement
# OJALOOM_WA_TEMPLATE_LANG=en

# ---- local development only ----------------------------------------------------------------------
# OJALOOM_ENV=development  (then:  python ojaloom_server.py --no-browser   and the web app at http://127.0.0.1:5173)
