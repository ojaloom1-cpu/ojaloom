# Oja Loom on DigitalOcean: settings and secrets.
# bootstrap.sh copies this to /etc/ojaloom/ojaloom.env (readable by root only). Never put the real file in git.
#
# RULES for this file:  one KEY=value per line.  NO quotes.  NO comment after a value (comments go on their own line).

# ---- required: the two addresses (they must share ONE registrable domain, e.g. app.yourshop.com + api.yourshop.com) ----
OJALOOM_ENV=production
OJALOOM_FRONTEND_URL=https://app.example.com
OJALOOM_PUBLIC_API_URL=https://api.example.com
OJALOOM_ALLOWED_ORIGINS=https://app.example.com

# ---- identity shown on the Terms page ----
OJALOOM_OPERATOR_NAME=Your Company Ltd
OJALOOM_SUPPORT_EMAIL=support@example.com
OJALOOM_SUPPORT_WHATSAPP=2347074235945
OJALOOM_ENFORCE_PAYWALL=1

# ---- backup bucket (any S3-compatible service; see docs/DIGITALOCEAN.md for the exact values per provider) ----
# DigitalOcean Spaces example:  s3://my-bucket/ojaloom   https://fra1.digitaloceanspaces.com   fra1
LITESTREAM_REPLICA_URL=s3://BUCKET_NAME/ojaloom
LITESTREAM_ENDPOINT=https://REPLACE_ME
LITESTREAM_REGION=REPLACE_ME
LITESTREAM_ACCESS_KEY_ID=REPLACE_ME
LITESTREAM_SECRET_ACCESS_KEY=REPLACE_ME

# ---- Paystack (remove the leading # and paste your key; sk_test_... while testing, sk_live_... when real) ----
# OJALOOM_PAYSTACK_SECRET=sk_test_xxx

# ---- WhatsApp Business Cloud API (optional, see docs/WHATSAPP.md) ----
# OJALOOM_WA_PHONE_ID=123456789012345
# OJALOOM_WA_TOKEN=xxx
